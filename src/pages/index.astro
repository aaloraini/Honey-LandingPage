---
import { ClientRouter, slide } from 'astro:transitions';
import Header from '../components/Header.astro';
import ScrollStage from '../components/ScrollStage.astro';
import '../styles/global.css';
import { variants } from '../data/variants';
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Siberian Gold — premium Russian honey. Harvested from untouched wildflower meadows and ancient Siberian forests. 300 AED per 250g jar." />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content="Siberian Gold — Premium Russian Honey" />
    <meta property="og:description" content="Siberian Gold — Flowers & Forest honey. 100% raw, unfiltered. 300 AED per 250g jar." />
    <meta property="og:type" content="website" />

    <!-- Preconnect for Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,600;1,300&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>Siberian Gold — Premium Russian Honey</title>
    <ClientRouter />
  </head>

  <body class="page-products">
    <Header path={path} />
    <main
      id="page-content"
      transition:name="page-content"
      transition:animate={slide({ duration: '0.4s', easing: 'cubic-bezier(0.4, 0, 0.2, 1)' })}
    >
      <ScrollStage variants={variants} />
    </main>

    <script>
      import { gsap } from 'gsap';
      import { variants, VARIANT_COUNT } from '../data/variants';

      // ── Utilities ──────────────────────────────────────────────────────────
      function hexToRgb(hex: string) {
        const n = parseInt(hex.replace('#', ''), 16);
        return { r: (n >> 16) & 255, g: (n >> 8) & 255, b: n & 255 };
      }
      function getLuminance(r: number, g: number, b: number) {
        return (0.299 * r + 0.587 * g + 0.114 * b) / 255;
      }

      // ── Module-level mutable state (persists across View Transition swaps) ─
      let jars:               HTMLImageElement[] = [];
      let headlineEl:         HTMLElement | null = null;
      let descriptionEl:      HTMLElement | null = null;
      let mobileDescEl:       HTMLElement | null = null;
      let variantNameEl:      HTMLElement | null = null;

      const isMobile = () => window.innerWidth <= 768;
      // Peek position differs on mobile vs desktop
      const peekPos = () => isMobile()
        ? { x: '32vw', y: '22vh', scale: 0.2 }
        : { x: '42vw', y: '38vh', scale: 0.28 };

      let bgRgb = { ...hexToRgb(variants[0].colors.background) };
      let acRgb = { ...hexToRgb(variants[0].colors.accent) };
      let txRgb = { ...hexToRgb(variants[0].colors.text) };
      let mtRgb = { ...hexToRgb(variants[0].colors.textMuted) };

      let currentIndex = 0;
      let isAnimating  = false;
      let wheelAccum   = 0;
      let touchStartY  = 0;

      // ── Color writer ───────────────────────────────────────────────────────
      function applyColors() {
        const root = document.documentElement;
        root.style.setProperty('--current-bg', `rgb(${Math.round(bgRgb.r)},${Math.round(bgRgb.g)},${Math.round(bgRgb.b)})`);
        root.style.setProperty('--accent-color-r', String(Math.round(acRgb.r)));
        root.style.setProperty('--accent-color-g', String(Math.round(acRgb.g)));
        root.style.setProperty('--accent-color-b', String(Math.round(acRgb.b)));
        root.style.setProperty('--text-primary-r', String(Math.round(txRgb.r)));
        root.style.setProperty('--text-primary-g', String(Math.round(txRgb.g)));
        root.style.setProperty('--text-primary-b', String(Math.round(txRgb.b)));
        root.style.setProperty('--text-muted-r', String(Math.round(mtRgb.r)));
        root.style.setProperty('--text-muted-g', String(Math.round(mtRgb.g)));
        root.style.setProperty('--text-muted-b', String(Math.round(mtRgb.b)));
        const isLight = getLuminance(bgRgb.r, bgRgb.g, bgRgb.b) > 0.45;
        root.style.setProperty('--header-fg', isLight ? '#1A120B' : '#F0EBE1');
        root.style.setProperty('--logo-filter', isLight ? 'none' : 'invert(1) brightness(2)');
      }

      // ── Init — re-runs every time products page is loaded via View Transitions
      function init() {
        // Kill any running GSAP tweens from a previous visit
        gsap.killTweensOf('.jar-image');

        // Re-acquire fresh DOM refs from the newly-swapped DOM
        jars          = Array.from(document.querySelectorAll<HTMLImageElement>('.jar-image'));
        headlineEl    = document.getElementById('hero-headline');
        descriptionEl = document.getElementById('hero-description');
        mobileDescEl  = document.getElementById('hero-description-mobile');
        variantNameEl = document.getElementById('hero-variant-name');

        // Reset state to first variant
        currentIndex = 0;
        isAnimating  = false;
        wheelAccum   = 0;

        bgRgb = { ...hexToRgb(variants[0].colors.background) };
        acRgb = { ...hexToRgb(variants[0].colors.accent) };
        txRgb = { ...hexToRgb(variants[0].colors.text) };
        mtRgb = { ...hexToRgb(variants[0].colors.textMuted) };

        // Place non-active jars at peek position
        const peek = peekPos();
        jars.forEach((jar, i) => {
          if (i === 0) gsap.set(jar, { clearProps: 'all' });
          else gsap.set(jar, { autoAlpha: 1, ...peek, rotation: 0 });
        });

        applyColors();
      }

      // ── Variant transition ─────────────────────────────────────────────────
      function goTo(toIdx: number) {
        if (isAnimating || !headlineEl || !descriptionEl || !variantNameEl) return;
        isAnimating = true;

        const to     = variants[toIdx];
        const jarOut = jars[currentIndex];
        const jarIn  = jars[toIdx];
        const bgTo   = hexToRgb(to.colors.background);
        const acTo   = hexToRgb(to.colors.accent);
        const txTo   = hexToRgb(to.colors.text);
        const mtTo   = hexToRgb(to.colors.textMuted);

        const tl = gsap.timeline({
          onComplete() { currentIndex = toIdx; isAnimating = false; },
        });

        tl.to(bgRgb, { r: bgTo.r, g: bgTo.g, b: bgTo.b, duration: 1, ease: 'none', onUpdate: applyColors }, 0);
        tl.to(acRgb, { r: acTo.r, g: acTo.g, b: acTo.b, duration: 1, ease: 'none', onUpdate: applyColors }, 0);
        tl.to(txRgb, { r: txTo.r, g: txTo.g, b: txTo.b, duration: 1, ease: 'none', onUpdate: applyColors }, 0);
        tl.to(mtRgb, { r: mtTo.r, g: mtTo.g, b: mtTo.b, duration: 1, ease: 'none', onUpdate: applyColors }, 0);

        tl.to(jarOut, { autoAlpha: 0, duration: 0.2, ease: 'power2.in' }, 0);
        const peek = peekPos();
        const teleport = isMobile()
          ? { x: '55vw', y: '40vh', scale: 0.18 }
          : { x: '70vw', y: '58vh', scale: 0.25 };
        tl.set(jarOut, teleport, 0.21);
        tl.to(jarOut, { ...peek, autoAlpha: 1, ease: 'power2.out', duration: 0.5 }, 0.55);

        tl.to([headlineEl, descriptionEl], { autoAlpha: 0, y: -24, stagger: 0.04, ease: 'power2.in', duration: 0.22 }, 0.05);
        tl.to(jarIn,  { autoAlpha: 1, x: 0, y: 0, rotation: 0, scale: 1, ease: 'power3.out', duration: 0.65 }, 0.15);

        tl.call(() => {
          headlineEl!.innerHTML         = to.headline.replace('\n', '<br>');
          if (descriptionEl) descriptionEl.textContent = to.description;
          if (mobileDescEl)  mobileDescEl.textContent  = to.description;
          variantNameEl!.textContent    = to.name;
        }, [], 0.62);

        tl.to([headlineEl, descriptionEl], { autoAlpha: 1, y: 0, stagger: 0.05, ease: 'power2.out', duration: 0.32 }, 0.65);
      }

      // ── Input listeners (added once; closures reference the live module vars)
      window.addEventListener('wheel', (e) => {
        if (!document.getElementById('scroll-stage')) return;
        e.preventDefault();
        if (isAnimating) return;
        wheelAccum += e.deltaY;
        if (Math.abs(wheelAccum) >= 60) {
          const dir = wheelAccum > 0 ? 1 : -1;
          wheelAccum = 0;
          goTo((currentIndex + dir + VARIANT_COUNT) % VARIANT_COUNT);
        }
      }, { passive: false });

      window.addEventListener('touchstart', (e) => {
        touchStartY = e.touches[0].clientY;
      }, { passive: true });

      window.addEventListener('touchend', (e) => {
        if (!document.getElementById('scroll-stage') || isAnimating) return;
        const delta = touchStartY - e.changedTouches[0].clientY;
        if (Math.abs(delta) > 40) {
          goTo((currentIndex + (delta > 0 ? 1 : -1) + VARIANT_COUNT) % VARIANT_COUNT);
        }
      }, { passive: true });

      // ── Boot ───────────────────────────────────────────────────────────────
      init();
      document.addEventListener('astro:page-load', () => {
        if (document.getElementById('scroll-stage')) init();
      });
    </script>

    <script>
      // Cross-page slide direction + nav dot updates
      const base2     = import.meta.env.BASE_URL.replace(/\/$/, '');
      const PAGE_ORDER: Record<string, number> = {
        [`${base2}/`]:        0,
        [`${base2}/story`]:   1,
        [`${base2}/origin`]:  2,
      };

      document.addEventListener('astro:before-preparation', (e: Event) => {
        const ev = e as any;
        const currentIdx = PAGE_ORDER[window.location.pathname] ?? 0;
        const destPath   = typeof ev.to === 'string' ? new URL(ev.to).pathname : ev.to.pathname;
        const destIdx    = PAGE_ORDER[destPath] ?? 0;
        ev.direction     = destIdx >= currentIdx ? 'forward' : 'back';
      });

      document.addEventListener('astro:page-load', () => {
        const path = window.location.pathname;
        document.querySelectorAll<HTMLAnchorElement>('.nav-link').forEach(link => {
          const isActive = link.getAttribute('href') === path;
          link.classList.toggle('nav-link--active', isActive);
          if (isActive) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        });
        document.querySelectorAll<HTMLSpanElement>('.nav-dot').forEach(dot => {
          dot.classList.toggle('is-active', dot.dataset.page === path);
        });
      });
    </script>
  </body>
</html>

---
import Base from '../layouts/Base.astro';
---

<Base title="Origin" description="The origin of Siberian Gold — harvested from the Russian wilderness.">
  <main class="placeholder-page">
    <div class="placeholder-inner">
      <span class="placeholder-label">Our Origin</span>
      <h1 class="placeholder-heading">Rooted in the<br /><em>Russian Wild</em></h1>
      <p class="placeholder-body">
        Deep within Siberia's ancient forests and wildflower meadows — the full origin story of Siberian Gold is coming soon.
      </p>
      <a href="/" class="placeholder-back">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M13 8H3M7 4l-4 4 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Back to Products
      </a>
    </div>
  </main>
</Base>

<style>
  .placeholder-page {
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 5vw 0;
  }

  .placeholder-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
    max-width: 560px;
  }

  .placeholder-label {
    font-family: "DM Sans", system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(var(--accent-color-r, 200), var(--accent-color-g, 134), var(--accent-color-b, 10));
  }

  .placeholder-heading {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(2.8rem, 5vw, 4.2rem);
    font-weight: 300;
    line-height: 1.1;
    color: var(--text-primary, #1A120B);
  }

  .placeholder-heading em {
    font-style: italic;
  }

  .placeholder-body {
    font-family: "DM Sans", system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.8;
    color: #6B5744;
    max-width: 38ch;
  }

  .placeholder-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    font-family: "DM Sans", system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: #6B5744;
    transition: opacity 0.2s ease;
  }

  .placeholder-back:hover {
    opacity: 0.6;
  }
</style>

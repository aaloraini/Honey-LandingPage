---
import type { HoneyVariant } from '../data/variants';

interface Props {
  variants: HoneyVariant[];
  initial: HoneyVariant;
}

const { variants, initial } = Astro.props;
---

<div id="col-right">
  <!-- Price block -->
  <div class="price-block">
    <span class="text-weight-label" id="hero-weight">{initial.weight}</span>
    <div class="text-price" id="hero-price" data-field="price">{initial.price}</div>
    <span class="text-per-jar">Per Jar · Free Delivery</span>
  </div>

  <!-- Current variant name bubble -->
  <div class="variant-label">
    <span class="variant-label-dot" aria-hidden="true"></span>
    <span id="hero-variant-name">{initial.name}</span>
  </div>

  <!-- Small origin note -->
  <p class="origin-note" id="hero-origin">
    <span class="origin-icon" aria-hidden="true">✦</span>
    100% Raw · Cold-Extracted
  </p>
</div>

<style>
  .price-block {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  .variant-label {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    border-radius: 9999px;
    border: 1px solid rgb(var(--accent-color-r, 200), var(--accent-color-g, 134), var(--accent-color-b, 10));
    font-family: "DM Sans", system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--text-primary-r, 26), var(--text-primary-g, 18), var(--text-primary-b, 11));
    white-space: nowrap;
  }

  .variant-label-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgb(var(--accent-color-r, 200), var(--accent-color-g, 134), var(--accent-color-b, 10));
    flex-shrink: 0;
  }

  .origin-note {
    font-family: "DM Sans", system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 300;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--text-muted-r, 107), var(--text-muted-g, 87), var(--text-muted-b, 68));
    display: flex;
    align-items: center;
    gap: 8px;
    opacity: 0.7;
  }

  .origin-icon {
    font-size: 0.6rem;
    color: rgb(var(--accent-color-r, 200), var(--accent-color-g, 134), var(--accent-color-b, 10));
  }
</style>

---
interface Props {
  path?: string;
}

const { path = '/' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const pages = [
  { href: `${base}/`,        label: 'Products' },
  { href: `${base}/story`,   label: 'Story'    },
  { href: `${base}/origin`,  label: 'Origin'   },
];
---

<header id="site-header" transition:name="site-header" transition:animate="none">
  <!-- Logo -->
  <a href={`${base}/`} class="header-logo" aria-label="Home">
    <img
      src={`${base}/images/logo.svg`}
      alt="Siberian Gold"
      class="logo-img"
      height="32"
    />
  </a>

  <!-- Pill navigation + dots indicator -->
  <div class="nav-wrapper">
    <nav id="pill-nav" aria-label="Main navigation">
      {pages.map((page, i) => (
        <>
          {i > 0 && <span class="nav-divider" aria-hidden="true"></span>}
          <a
            href={page.href}
            class={`header-link nav-link${path === page.href ? ' nav-link--active' : ''}`}
            aria-current={path === page.href ? 'page' : undefined}
          >
            {page.label}
          </a>
        </>
      ))}
    </nav>

    <!-- Page position dots -->
    <div id="nav-dots" aria-hidden="true">
      {pages.map(page => (
        <span
          class={`nav-dot${path === page.href ? ' is-active' : ''}`}
          data-page={page.href}
        ></span>
      ))}
    </div>
  </div>

  <!-- Contact button -->
  <a href="#contact" class="contact-btn" aria-label="Contact us">Contact</a>
</header>

<style>
  #site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 5vw;
    height: 80px;
  }

  .header-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .logo-img {
    height: 20px;
    width: auto;
    object-fit: contain;
    display: block;
    filter: var(--logo-filter, none);
    transition: filter 0.5s ease;
  }

  .nav-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
  }

  @media (max-width: 768px) {
    #site-header {
      height: 64px;
      padding: 0 6vw;
      grid-template-columns: 1fr auto;
    }

    .logo-img {
      height: 18px;
    }

    .nav-wrapper {
      display: none;
    }

    .contact-btn {
      padding: 8px 16px;
      font-size: 0.7rem;
    }
  }

  #pill-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    min-width: 300px;
    padding: 11px 36px;
  }

  .nav-link {
    text-decoration: none;
    font-family: "DM Sans", system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0 28px;
  }

  .nav-link--active {
    font-weight: 500;
  }

  .nav-divider {
    display: block;
    width: 1px;
    height: 14px;
    background: currentColor;
    opacity: 0.2;
    flex-shrink: 0;
  }

  .contact-btn {
    justify-self: end;
    text-decoration: none;
    font-family: "DM Sans", system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 10px 22px;
    border-radius: 9999px;
    background: rgb(var(--accent-color-r), var(--accent-color-g), var(--accent-color-b));
    color: #ffffff;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .contact-btn:hover {
    opacity: 0.82;
    transform: translateY(-1px);
  }
</style>

---
import { ClientRouter, slide } from 'astro:transitions';
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Siberian Gold — Premium Russian Honey.' } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,600;1,300&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — Siberian Gold</title>
    <ClientRouter />
  </head>

  <body>
    <Header path={path} />
    <!-- Slide wrapper — persists across navigations, drives the page transition -->
    <div
      id="page-content"
      transition:name="page-content"
      transition:animate={slide({ duration: '0.4s', easing: 'cubic-bezier(0.4, 0, 0.2, 1)' })}
    >
      <slot />
    </div>

    <script>
      const PAGE_ORDER: Record<string, number> = { '/': 0, '/story': 1, '/origin': 2 };

      // Override direction before each navigation based on page order
      document.addEventListener('astro:before-preparation', (e: Event) => {
        const ev = e as any;
        const currentIdx = PAGE_ORDER[window.location.pathname] ?? 0;
        const destPath   = typeof ev.to === 'string' ? new URL(ev.to).pathname : ev.to.pathname;
        const destIdx    = PAGE_ORDER[destPath] ?? 0;
        ev.direction     = destIdx >= currentIdx ? 'forward' : 'back';
      });

      // Update header active states + nav dots after each SPA navigation
      document.addEventListener('astro:page-load', () => {
        const path = window.location.pathname;

        document.querySelectorAll<HTMLAnchorElement>('.nav-link').forEach(link => {
          const isActive = link.getAttribute('href') === path;
          link.classList.toggle('nav-link--active', isActive);
          if (isActive) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        });

        document.querySelectorAll<HTMLSpanElement>('.nav-dot').forEach(dot => {
          dot.classList.toggle('is-active', dot.dataset.page === path);
        });
      });
    </script>
  </body>
</html>
